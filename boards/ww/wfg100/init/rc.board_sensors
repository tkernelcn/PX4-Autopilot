#!/bin/sh
#
# board specific sensors init for Wuwei WFG100
#------------------------------------------------------------------------------

# 1) ADC (voltage/current/RSSI/airspeed)
board_adc start

# Conservative IMU filter profile for W689 flight validation.
param set-default IMU_GYRO_CUTOFF 25
param set-default IMU_DGYRO_CUTOFF 12
param set-default IMU_ACCEL_CUTOFF 20

# 2) IMU1: SPI1 (-b 1)
if ! w689 start -s -b 1 -R 6 -q
then
	if ! w688 start -s -b 1 -R 6 -q
	then
		if ! icm42605 start -s -b 1 -R 26 -q
		then
			if ! icm42688p start -s -b 1 -R 26 -q
			then
				bmi270 start -s -b 1 -R 8 -q
			fi
		fi
	fi
fi

# 3) IMU2: SPI4 (-b 4)
# Start W689 first, keep fallback chain for other IMU variants.
if ! w689 start -s -b 4 -R 6 -q
then
	if ! w688 start -s -b 4 -R 6 -q
	then
		if ! icm42605 start -s -b 4 -R 26 -q
		then
			if ! icm42688p start -s -b 4 -R 26 -q
			then
				bmi270 start -s -b 4 -R 8 -q
			fi
		fi
	fi
fi

# 4) Barometer: internal I2C, prefer DPS310 and keep SPL06 fallback
if ! dps310 start -I -a 0x77 -q
then
	if ! spl06 start -I -a 0x76 -q
	then
		dps310 start -I -a 0x76 -q
	fi
fi

# 5) Magnetometer: prefer QMC5883P @ 0x2C, then QMC5883L @ 0x0D, then IST8310 @ 0x0E
if ! qmc5883p start -I -a 0x2C -R 27 -q
then
	if ! qmc5883l start -I -a 0x0D -R 27 -q
	then
		ist8310 start -I -a 0x0E -R 0 -q
	fi
fi
